    },

    "bookings": {
      ".read": "auth != null && (auth.token.email === 'cybermohammed3@gmail.com' || root.child('admins').child(auth.uid).child('status').val() === 'active')",
      "$bookingId": {
        ".read": "auth != null && (auth.token.email === 'cybermohammed3@gmail.com' || root.child('admins').child(auth.uid).child('status').val() === 'active')",
        ".write": "(!data.exists() && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('phone').isString() && newData.child('phone').val().length >= 7 && newData.child('date').isString() && newData.child('time').isString() && newData.child('status').val() === 'confirmed') || (auth != null && (auth.token.email === 'cybermohammed3@gmail.com' || root.child('admins').child(auth.uid).child('status').val() === 'active'))"
      }
    },

