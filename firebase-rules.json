      ".write": "auth != null && (auth.token.email === 'cybermohammed3@gmail.com' || root.child('admins').child(auth.uid).child('status').val() === 'active' || (!data.exists() && root.child('pending_cashiers').child(auth.token.email.replace('.', '_')).exists()))",
